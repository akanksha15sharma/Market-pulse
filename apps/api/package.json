{
  "name": "@marketpulse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "test:db": "node --import tsx --test --test-concurrency=1 tests/integration/database.test.ts",
    "test:auth": "node --import tsx --test --test-concurrency=1 tests/unit/auth.test.ts tests/unit/email.test.ts",
    "test:auth:db": "node --import tsx --test --test-concurrency=1 tests/integration/auth.test.ts",
    "test:markets": "node --import tsx --test --test-concurrency=1 tests/unit/markets.test.ts",
    "test:markets:db": "node --import tsx --test --test-concurrency=1 tests/integration/markets.test.ts",
    "worker:dev": "node --watch --import tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "test:watchlists": "node --import tsx --test --test-concurrency=1 tests/unit/watchlists.test.ts",
    "test:watchlists:db": "node --import tsx --test --test-concurrency=1 tests/integration/watchlists.test.ts",
    "markets:check": "node --import tsx src/tools/check-markets.ts",
    "test:alerts": "node --import tsx --test --test-concurrency=1 tests/unit/alerts.test.ts",
    "test:alerts:db": "node --import tsx --test --test-concurrency=1 tests/integration/alerts.test.ts",
    "test:config": "node --import tsx --test --test-concurrency=1 tests/unit/config.test.ts",
    "production:check": "node dist/tools/check-production.js",
    "worker:once": "node dist/tools/run-market-once.js",
    "test:seed": "node --import tsx --test --test-concurrency=1 tests/unit/seed.test.ts",
    "test:notifications": "node --import tsx --test --test-concurrency=1 tests/unit/notifications.test.ts tests/unit/notification-api.test.ts",
    "test:notifications:db": "node --import tsx --test --test-concurrency=1 tests/integration/notifications.test.ts tests/integration/notification-api.test.ts tests/integration/notification-producers.test.ts tests/integration/notification-release.test.ts"
  },
  "dependencies": {
    "@marketpulse/contracts": "*",
    "express": "^5.1.0",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "prisma": "7.10.1",
    "@types/pg": "^8.15.6"
  }
}
