NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Match the root Compose credentials.
DATABASE_URL=postgresql://marketpulse:marketpulse_dev@localhost:5432/marketpulse
# Market credentials are server-only. Never use VITE_ variables for keys.

# Optional unpooled URL for migrations; falls back to DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://marketpulse:marketpulse_dev@localhost:5432/marketpulse
# Dedicated local database, never an application or external account database.
TEST_DATABASE_URL=postgresql://marketpulse:marketpulse_dev@localhost:5432/marketpulse_test

# Exact browser-facing origin, without a trailing slash. HTTPS in production.
APP_ORIGIN=http://127.0.0.1:5173
# Empty means no trusted proxy. Use only your proxy's IPs/CIDRs, never all IPs.
TRUSTED_PROXIES=
SESSION_TTL_SECONDS=604800
# Generate a stable 32-byte secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required in production; development generates a temporary process-local secret.
# CSRF_SECRET=
# Server-wide notification APIs/producers; explicit opt-in, restart required.
NOTIFICATIONS_ENABLED=false
# Mailpit only captures local mail. Production account email remains disabled.
EMAIL_MODE=mailpit
MAILPIT_URL=http://127.0.0.1:8025

# Keyless public CoinPaprika API; no account, key or billing window required.
# Explicit demo mode remains available for offline development/tests.
CRYPTO_DATA_MODE=coinpaprika
STOCK_DATA_MODE=demo
MARKET_WORKER_ENABLED=true
MARKET_ALWAYS_ON=false
CP_MINUTE_ATTEMPT_LIMIT=10
CP_DAILY_ATTEMPT_LIMIT=260
CP_MONTHLY_ATTEMPT_LIMIT=8000
CP_CHART_DAILY_LIMIT=80
