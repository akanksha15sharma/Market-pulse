{
  "name": "marketpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "npm run db:generate -w @marketpulse/api && npm run build -w @marketpulse/contracts && node scripts/dev.mjs",
    "build": "npm run build -w @marketpulse/contracts && npm run build -w @marketpulse/api && npm run build -w @marketpulse/web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run db:generate -w @marketpulse/api && npm run build -w @marketpulse/contracts && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @marketpulse/api",
    "db:validate": "npm run db:validate -w @marketpulse/api",
    "db:migrate": "npm run db:migrate -w @marketpulse/api",
    "db:deploy": "npm run db:deploy -w @marketpulse/api",
    "db:status": "npm run db:status -w @marketpulse/api",
    "db:seed": "npm run db:seed -w @marketpulse/api",
    "test:db": "npm run test:db -w @marketpulse/api",
    "test:auth": "npm run test:auth -w @marketpulse/api",
    "test:auth:db": "npm run test:auth:db -w @marketpulse/api",
    "test:web": "node scripts/test-web.mjs",
    "test": "npm run build -w @marketpulse/contracts && npm run test:deployment && npm run test:config && npm run test:auth && npm run test:web && npm run test:markets && npm run test:watchlists && npm run test:alerts",
    "test:markets": "npm run test:markets -w @marketpulse/api",
    "test:markets:db": "npm run test:markets:db -w @marketpulse/api",
    "worker:dev": "npm run db:generate -w @marketpulse/api && npm run build -w @marketpulse/contracts && npm run worker:dev -w @marketpulse/api",
    "worker:start": "npm run worker:start -w @marketpulse/api",
    "test:watchlists": "npm run test:watchlists -w @marketpulse/api",
    "test:watchlists:db": "npm run test:watchlists:db -w @marketpulse/api",
    "markets:check": "npm run markets:check -w @marketpulse/api",
    "test:alerts": "npm run test:alerts -w @marketpulse/api",
    "test:alerts:db": "npm run test:alerts:db -w @marketpulse/api",
    "test:config": "npm run test:config -w @marketpulse/api",
    "production:check": "npm run production:check -w @marketpulse/api",
    "start": "npm run production:check && npm run start -w @marketpulse/api",
    "start:worker": "npm run worker:start -w @marketpulse/api",
    "worker:once": "npm run worker:once -w @marketpulse/api",
    "test:deployment": "node --test scripts/test-deployment.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  }
}
