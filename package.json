{
  "name": "marketpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "npm run build -w @marketpulse/contracts && node scripts/dev.mjs",
    "build": "npm run build -w @marketpulse/contracts && npm run build -w @marketpulse/api && npm run build -w @marketpulse/web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run build -w @marketpulse/contracts && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
